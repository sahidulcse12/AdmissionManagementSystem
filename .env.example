# Copy to .env and adjust. All values have safe defaults in docker-compose.yml.

# PostgreSQL
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend API
API_PORT=8080
# How long a seat hold lasts before it expires (seconds).
HOLD_DURATION_SECONDS=600
# How often the background job marks overdue holds as EXPIRED (seconds).
EXPIRY_SWEEP_SECONDS=15
# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*

# Frontend
FRONTEND_PORT=5173
# URL the browser uses to reach the API.
API_URL=http://localhost:8080
